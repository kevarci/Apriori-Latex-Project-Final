# Environment configuration for Apriori Recommendation System
# Copy this file to .env and adjust the values as needed

# Data file paths
TRANSACTIONS_FILE=TransactionsInstacart.csv
PRODUCTS_FILE=products.csv
ORDERS_FILE=order_products__train.csv

# Apriori algorithm parameters
MIN_SUPPORT=0.01
MIN_CONFIDENCE=0.3
MIN_LIFT=1.0

# Data processing parameters
MIN_PRODUCTS_PER_ORDER=2
MAX_PRODUCTS_PER_ORDER=50

# Visualization parameters
DEFAULT_TOP_N=20
FIGURE_DPI=100

# Streamlit configuration
STREAMLIT_PORT=8501
STREAMLIT_HOST=localhost

# Logging configuration
LOG_LEVEL=INFO
